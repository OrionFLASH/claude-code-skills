{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "android-qa-audit/finding.schema.json",
  "title": "android-qa-audit findings.json",
  "description": "Находки прогона по Android-приложению. Находки исполнителей (потоков) и скриптов приводятся к этому формату; id и fingerprint проставляет оркестратор (fingerprint.py compute). Секреты и персональные данные — замаскированы до записи (safety-rules.md §5).",
  "type": "object",
  "required": ["run", "findings"],
  "properties": {
    "run": {
      "type": "object",
      "required": ["id", "app", "depth", "mode"],
      "properties": {
        "id": {"type": "string", "description": "<YYYY-MM-DD>-<package>"},
        "app": {"type": "string", "description": "package, например com.example.app"},
        "app_version": {"type": "string", "description": "versionName (versionCode)"},
        "depth": {"enum": ["smoke", "standard", "deep"]},
        "mode": {"enum": ["live", "dry-run"]},
        "started_at": {"type": "string"},
        "finished_at": {"type": "string"}
      }
    },
    "not_checked": {
      "type": "array",
      "description": "Что не проверено и почему (запрет, нет образа, нет стенда, ограничение adb, нужен вход…)",
      "items": {
        "type": "object",
        "required": ["what", "reason"],
        "properties": {
          "what": {"type": "string"},
          "reason": {"type": "string"},
          "rule": {"type": ["string", "null"], "description": "id правила guard.py, если причина — запрет"},
          "direction": {"type": "string"},
          "cell": {"type": "string", "description": "ячейка матрицы c01…"}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "metrics": {
      "type": "array",
      "description": "Сводка метрик по ячейкам (холодный запуск, память, jank) — для отчёта",
      "items": {"type": "object"}
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "direction", "check_id", "type", "severity", "title", "screen", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^F-\\d{3,}$", "description": "F-001…, уникален в прогоне"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "direction": {
          "enum": ["functional", "logic-state", "ux", "visual-ui", "device-config-compat", "lifecycle-resilience",
                   "accessibility", "performance", "security-passive", "compatibility", "content-i18n"]
        },
        "check_id": {"type": "string", "description": "id пункта чек-листа: fn.primary-flow, life.process-death, a11y.missing-label…"},
        "type": {
          "enum": ["bug", "crash", "anr", "ux-issue", "a11y", "performance", "content", "security", "visual", "compat",
                   "proposal", "suggestion", "user-story"]
        },
        "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
        "title": {"type": "string", "maxLength": 120, "description": "Что не так и где, без оценок: «Профиль: текст кнопки «Сохранить» обрезан при шрифте 1.3»"},
        "package": {"type": "string"},
        "app_version": {"type": "string"},
        "screen": {"type": "string", "description": "Экран: activity (com.example.app.ui.ProfileActivity) или название экрана, если activity одна"},
        "element": {"type": ["string", "null"], "description": "Стабильный локатор: id=<resource-id> или text=\"…\" + класс"},
        "steps": {"type": "array", "items": {"type": "string"}, "description": "Шаги воспроизведения с чистого запуска"},
        "expected": {"type": "string"},
        "actual": {"type": "string"},
        "environment": {
          "type": "object",
          "properties": {
            "api": {"type": "integer"},
            "android_version": {"type": "string"},
            "device_profile": {"type": "string", "description": "phone / low-end / tablet / fold / small / модель реального устройства"},
            "ram_mb": {"type": "integer"},
            "cores": {"type": "integer"},
            "abi": {"type": "string"},
            "screen": {"type": "string", "description": "WxH@dpi"},
            "orientation": {"enum": ["portrait", "landscape", null]},
            "locale": {"type": "string"},
            "dark_mode": {"type": "boolean"},
            "font_scale": {"type": "number"},
            "network": {"type": "string", "description": "wifi / 4g / 3g / edge / offline / switch"},
            "battery": {"type": "string"},
            "stand": {"enum": ["own-emulator", "foreign-emulator", "real"]},
            "avd": {"type": "string"},
            "cell": {"type": "string", "description": "ячейка матрицы c01…"},
            "date": {"type": "string"}
          }
        },
        "environment_list": {"type": "array", "items": {"type": "string"}, "description": "Все окружения, где воспроизводится: «API 34 · phone 4 ГБ · dark»"},
        "repro_rate": {"type": "string", "pattern": "^\\d+/\\d+$", "description": "Воспроизвелось / попыток: 3/3"},
        "frequency": {"enum": ["always", "sometimes", "once", null]},
        "crash": {
          "type": "object",
          "description": "Падение или ANR",
          "properties": {
            "type": {"enum": ["crash", "anr", "native"]},
            "summary": {"type": "string", "description": "Исключение или причина ANR (замаскировано)"},
            "process": {"type": "string"},
            "time": {"type": "string"}
          }
        },
        "logcat_excerpt": {"type": "string", "description": "Относящиеся к находке строки logcat, замаскированные, до ~40 строк"},
        "logcat_file": {"type": "string", "description": "Путь относительно папки прогона: logs/logcat-….txt"},
        "screenshots": {"type": "array", "items": {"type": "string"}, "description": "Пути относительно папки прогона; аннотированный (-annotated.png) — первым, затем оригинал"},
        "shots": {
          "type": "array",
          "description": "Снимки с разметкой (finding.py, annotate_android.py): черновики issues показывают annotated",
          "items": {
            "type": "object",
            "properties": {
              "original": {"type": "string"}, "annotated": {"type": ["string", "null"]}, "spec": {"type": "string"},
              "marks": {"type": "array"}, "viewed": {"type": "boolean", "description": "аннотированный снимок просмотрен (Read) до публикации"},
              "check": {"type": "object"}
            }
          }
        },
        "recordings": {"type": "array", "items": {"type": "string"}, "description": "Пути видео относительно папки прогона; пути роликов clips[] дублируются сюда для совместимости"},
        "clips": {
          "type": "array",
          "description": "Короткие ролики без звука (1.5.0, references/clips.md; qa_clips.entry): дополнение к скриншоту, когда дефект виден во времени",
          "items": {
            "type": "object",
            "required": ["file"],
            "properties": {
              "file": {"type": "string", "description": "clips/F-003-menu.mp4 (относительно папки прогона)"},
              "gif": {"type": ["string", "null"]}, "poster": {"type": ["string", "null"]}, "sheet": {"type": ["string", "null"], "description": "лента кадров PNG — её смотрят (Read) вместо видео"},
              "kind": {"enum": ["error", "ok", "note", "after"]},
              "seconds": {"type": ["number", "null"]}, "bytes": {"type": ["integer", "null"]},
              "width": {"type": ["integer", "null"]}, "height": {"type": ["integer", "null"]}, "fps": {"type": ["number", "null"]},
              "codec": {"type": ["string", "null"]}, "audio": {"type": "boolean", "description": "всегда false: звук не пишется"},
              "caption": {"type": "string"}, "steps": {"type": "array", "items": {"type": "string"}},
              "encoder": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"]},
              "viewed": {"type": "boolean", "description": "лента кадров просмотрена и ролик подтверждён (finding.py clip-viewed) — иначе не публикуется"},
              "created": {"type": "string"}, "warning": {"type": "string"},
              "marks": {"type": "array"}, "frames": {"type": "array", "items": {"type": "string"}, "description": "без ffmpeg: скриншоты после каждого шага"},
              "source": {"enum": ["screenrecord", "rolling", "frames", "file"], "description": "frames — screenrecord недоступен, ролик из скриншотов (clip --fallback)"}, "serial": {"type": "string"},
              "black_ratio": {"type": ["number", "null"]}, "touches": {"type": "boolean"}, "caption_in_video": {"type": "boolean"}
            }
          }
        },
        "ui_dump": {"type": "string", "description": "raw/ui-….xml"},
        "metrics": {"type": "object", "description": "Числа: TotalTime, janky_percent, total_pss_kb…"},
        "evidence": {"type": "object", "description": "Направленческие данные; sensitive: true — не публиковать без решения"},
        "hypothesis": {"type": "string", "description": "Гипотеза причины (без исходников — гипотеза)"},
        "suggestion": {"type": "string"},
        "priority": {"enum": ["quick-win", "major-project", "fill-in", "thankless", null]},
        "sources": {"type": "array", "items": {"type": "string"}, "description": "own:checklist | own:script:<name> | plugin:<name>"},
        "merged_ids": {"type": "array", "items": {"type": "string"}},
        "status": {
          "enum": ["NEW", "DUPLICATE-OPEN", "FIXED-OK", "FIXED-INSUFFICIENT", "REGRESSION", "ALREADY-COPIED", "UNSURE-MATCH",
                   "NOT-CHECKED", "KNOWN", null]
        },
        "status_reason": {"type": "string"},
        "not_checked_reason": {"enum": ["forbidden", "no-stand", "no-image", "adb-limitation", "needs-login", "steps-unclear", "other", null]},
        "account_state": {"type": ["string", "null"]},
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repo": {"type": "string"},
              "number": {"type": "integer"},
              "url": {"type": "string"},
              "how": {"enum": ["marker", "fuzzy", "manual"]}
            }
          }
        },
        "question": {"type": ["string", "null"], "description": "Открытый вопрос пользователю (баг или задумано)"},
        "published": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repo": {"type": "string"},
              "number": {"type": "integer"},
              "url": {"type": "string"},
              "kind": {"enum": ["issue", "comment", "draft"]}
            }
          }
        },
        "related": {"type": "array", "items": {"type": "string"}},
        "repro": {
          "type": "object",
          "description": "Как перезапустить проверку одной командой (recheck.py): {adb: [аргументы adb_helpers.py], expect?, expect_exit?} или {argv | cmd}; только скрипты скила",
          "properties": {
            "adb": {"type": ["array", "string"]}, "argv": {"type": "array", "items": {"type": "string"}}, "cmd": {"type": "string"},
            "expect": {"type": "string"}, "expect_exit": {"type": "integer"}, "serial": {"type": "string"}, "note": {"type": "string"}
          }
        },
        "recheck": {
          "type": "object",
          "description": "Независимая перепроверка перед публикацией (recheck.py run/set)",
          "properties": {
            "status": {"enum": ["confirmed", "flaky", "not-reproduced", "error", "refused", "no-repro", "planned"]},
            "by": {"type": "string"}, "at": {"type": "string"}, "independent": {"type": "boolean"}, "manual": {"type": "boolean"},
            "runs": {"type": "array"}, "reason": {"type": "string"}, "note": {"type": "string"}
          }
        },
        "legal": {
          "type": "object",
          "description": "Правовые и финансовые утверждения: только со второй проверкой другим исполнителем и пометкой «проверить юристом»",
          "properties": {
            "claims_law": {"type": "boolean"}, "norms": {"type": "array", "items": {"type": "string"}},
            "jurisdictions": {"type": "array", "items": {"type": "string"}},
            "second_check": {"type": "object", "properties": {"by": {"type": "string"},
              "result": {"enum": ["confirmed", "corrected", "rejected"]}, "at": {"type": "string"}, "note": {"type": "string"}}},
            "lawyer_review": {"type": "boolean"}
          }
        },
        "ingested": {"type": "object", "description": "Откуда пришла находка (ingest_findings.py): поток и время"},
        "known": {"type": "object", "description": "status KNOWN: документ проекта, где это описано как известное/задуманное (known_docs.py set)",
                  "properties": {"doc": {"type": "string"}, "quote": {"type": "string"}, "by": {"type": "string"}, "at": {"type": "string"}}},
        "known_candidates": {"type": "array", "description": "Кандидаты «уже известно» (known_docs.py check) — прочитать цитату"},
        "source_id": {"type": "string", "description": "id находки у исполнителя (до присвоения F-NNN)"}
      },
      "if": {"properties": {"type": {"enum": ["proposal", "user-story", "suggestion"]}}},
      "else": {"required": ["actual"]},
      "description": "Находка. actual обязателен для всех типов, кроме proposal, suggestion и user-story."
    }
  }
}
